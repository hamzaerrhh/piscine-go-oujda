package main

import (
	"fmt"
	"os"
)



func main() {
	if len(os.Args) != 2 {
		return
	}
	argument := []byte(os.Args[1])

	var arby [2048]byte


	pos := 0
	openBr := 0        
	i := 0             
	N := len(argument) // length of the source code
	for i >= 0 && i < N {
		switch argument[i] {
		case '>':
			pos++
		case '<':
			pos--
		case '+':
			arby[pos]++
		case '-':
			arby[pos]--
		case '.':
			fmt.Printf("%c", rune(arby[pos]))
		case '[':
			openBr = 0

			if arby[pos] == 0 {

				for i < N &&  (argument[i] != byte(']') || openBr > 1) {
					if argument[i] == byte('[') {
						openBr++
					} else if argument[i] == byte(']') {
						openBr--
					}
					i++
				}
			}

		case ']':
			openBr = 0
	
			if arby[pos] != 0 {
				for i >= 0 && (argument[i] != byte('[') || openBr > 1) {
		
					if argument[i] == byte(']') {
						openBr++
					} else if argument[i] == byte('[') {
						openBr--
					}
					i--
				}
			}
		}
		i++
	}
}
